# Copiá este archivo como .env y completá los valores.
# Nunca subas el .env real al repositorio.

# ── Servidor ──────────────────────────────────────────────
PORT=3000
# Orígenes permitidos por CORS, separados por coma (opcional; si no se define se usan los de siempre)
CORS_ORIGINS=http://localhost:5173,https://www.tu-dominio.com

# ── Base de datos ─────────────────────────────────────────
# En local usá una base de PRUEBA, nunca la de producción
MONGO_URL=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/bulonera-test?retryWrites=true&w=majority

# ── Sesión (JWT) ──────────────────────────────────────────
# Cadena larga y aleatoria (mínimo 32 caracteres)
PRIVATE_KEY=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=24h

# ── Mercado Pago ──────────────────────────────────────────
# En local: access token de PRUEBA de tu cuenta
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# URL pública del backend + /api/mp/webhook (en local, la del túnel de cloudflared). Obligatoria en Railway.
MP_NOTIFICATION_URL=https://TU-BACKEND/api/mp/webhook
# URL pública del frontend (URLs de retorno de Mercado Pago)
FRONT_URL=http://localhost:5173
# true SOLO en local/pruebas: acepta pagos hechos con cuentas de prueba
MP_ACCEPT_TEST_PAYMENTS=false
# Opcional: clave secreta de webhooks del panel de MP
MP_WEBHOOK_SECRET=
# Opcional: true = rechaza notificaciones sin firma válida
MP_WEBHOOK_STRICT=false

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Emails (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
# Casilla que recibe los avisos internos de ventas y alertas
STORE_NOTIFICATION_EMAIL=ventas@tu-dominio.com
# Opcional: casilla que recibe las consultas del formulario de contacto
# (si no se define, se usa la casilla de la tienda). En local poné la tuya.
CONTACT_EMAIL_TO=
EMAIL_LOGO_URL=https://res.cloudinary.com/TU_CLOUD/image/upload/logo.png
STORE_URL=https://www.tu-dominio.com

# ── Enviopack ─────────────────────────────────────────────
ENVIOPACK_BASE_URL=https://api.enviopack.com
ENVIOPACK_API_KEY=
ENVIOPACK_SECRET_KEY=
ENVIOPACK_DIRECCION_ENVIO=
# false en local/pruebas: no crea envíos reales al aprobarse un pago
ENVIOPACK_CREAR_ENVIOS=false
